{
  "extends": "@hackney/eslint-config",
  "parserOptions": {
    "project": ["./tsconfig.json", "./tsconfig.test.json"]
  },
  "overrides": [
    {
      "files": ["lib/setupTests.ts", "lib/test-utils.ts"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true
          }
        ]
      }
    }
  ]
}
